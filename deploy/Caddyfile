# 学生端首页、静态资源、对话和价目接口公开；其余一律要口令：
# /studio 后台、/api/docs、评测、知识库写入、线索等。
# 访问日志：记录来源 IP、时间、路径、状态码，便于知道面试官有没有打开过；
# 去掉口令和 Cookie 这类敏感请求头，保留 User-Agent 和 Referer 以便区分真人与爬虫；按 10MB 轮转、保留 90 天。
# 查看方式见 deploy/DEPLOY.md。
(access_log) {
	log {
		output file /data/logs/{args[0]}-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>uri query {
				replace key REDACTED
			}
		}
	}
}

# GOEUROOPS_ADDRESS 默认等于 SITE_ADDRESS；同机把主地址让给别的站点时（例如个人主页），
# 在 .env 里设成子域名即可，例如 goeuroops.1.2.3.4.sslip.io
{$GOEUROOPS_ADDRESS} {
	encode zstd gzip
	import access_log goeuroops

	@private not path / /index.html /assets/* /runtime-config.js /favicon.ico /api/chat /api/chat/* /api/catalog
	basic_auth @private {
		{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
	}

	reverse_proxy frontend:80
}

# 同一台机器上的其他项目（例如 Vparser、个人主页）把站点配置放进 deploy/sites/*.caddy 即可，
# 静态站点的文件放在 CADDY_STATIC_DIR（挂载到 /srv），
# 共用这一个 Caddy 和证书；这些文件带口令哈希，只放在服务器上，不提交。
import /etc/caddy/sites/*.caddy

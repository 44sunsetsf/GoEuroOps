# 学生端首页、静态资源、对话和价目接口公开；其余一律要口令：
# /studio 后台、/api/docs、评测、知识库写入、线索等。
# 访问日志：记录来源 IP、时间、路径、状态码，便于知道面试官有没有打开过；
# 去掉口令和 Cookie 这类敏感请求头，保留 User-Agent 和 Referer 以便区分真人与爬虫；按 10MB 轮转、保留 90 天。
# 查看方式见 deploy/DEPLOY.md。
(access_log) {
	log {
		output file /data/logs/{args[0]}-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>uri query {
				replace key REDACTED
				replace guest REDACTED
			}
		}
	}
}

# GOEUROOPS_ADDRESS 默认等于 SITE_ADDRESS；同机把主地址让给别的站点时（例如个人主页），
# 在 .env 里设成子域名即可，例如 goeuroops.1.2.3.4.sslip.io
{$GOEUROOPS_ADDRESS} {
	encode zstd gzip
	import access_log goeuroops

	# route 里的指令按书写顺序执行，访客判断必须在 basic_auth 之前
	route {
		# 访客身份只能由这里加上：先删掉外部请求自带的同名请求头，防止伪造
		request_header -X-Studio-Role

		# 站长入口 /studio/owner：无论浏览器带没带访客 Cookie，都要求输入密码；通过后清掉访客 Cookie 再进后台。
		# 不这样的话，带着访客 Cookie 的浏览器访问 /studio 会直接以访客身份进入，永远不会弹出密码框。
		@owner_enter path /studio/owner /studio/owner/
		# handle 里的指令会被 Caddy 重排（redir 排在 basic_auth 前面，密码就被跳过了），所以要再包一层 route 保持书写顺序
		handle @owner_enter {
			route {
				basic_auth {
					{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
				}
				header Set-Cookie "goe_guest=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax"
				redir * /studio 302
			}
		}

		# 演示访客（面试官等）：打开 /studio?guest=<口令> 写入 30 天 Cookie，之后免密码只读访问后台。
		# 只读和打码由后端按 X-Studio-Role 执行（backend/api/demo_guard.py）。
		# 口令为空或太短时整个访客通道失效（例如容器没重建、没拿到 GOEUROOPS_GUEST_KEY 环境变量）
		@guest_enter {
			path /studio /studio/
			query guest={$GOEUROOPS_GUEST_KEY}
			expression `size("{$GOEUROOPS_GUEST_KEY}") >= 16`
		}
		handle @guest_enter {
			header Set-Cookie "goe_guest={$GOEUROOPS_GUEST_KEY}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
			redir * /studio 302
		}

		# 带访客 Cookie、且没有走站长密码登录的请求标记为访客
		@guest {
			header_regexp guest Cookie (^|;\s*)goe_guest={$GOEUROOPS_GUEST_KEY}(;|$)
			expression `size("{$GOEUROOPS_GUEST_KEY}") >= 16`
			not header Authorization *
		}
		request_header @guest X-Studio-Role guest

		@private {
			not path / /index.html /assets/* /runtime-config.js /favicon.ico /api/chat /api/chat/* /api/catalog
			not header X-Studio-Role guest
		}
		basic_auth @private {
			{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
		}

		reverse_proxy frontend:80
	}
}

# 同一台机器上的其他项目（例如 Vparser、个人主页）把站点配置放进 deploy/sites/*.caddy 即可，
# 静态站点的文件放在 CADDY_STATIC_DIR（挂载到 /srv），
# 共用这一个 Caddy 和证书；这些文件带口令哈希，只放在服务器上，不提交。
import /etc/caddy/sites/*.caddy

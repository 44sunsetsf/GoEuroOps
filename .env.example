# GoEuroOps 一键启动配置：cp .env.example .env 后填入真实值
# docker compose 会自动读取本文件

# 必填：DeepSeek（或其他兼容 Anthropic 协议的服务）的 API Key
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选
REDIS_PASSWORD=goeuroops123
LOG_LEVEL=INFO
# 前端访问端口（默认 80，被占用时改成别的，例如 8080）
FRONTEND_PORT=80
